# ============================================================
# AETHER Smart Home — Environment Configuration Template
# Copy this file to .env and fill in your values.
# The AI service reads this via python-dotenv at startup.
# ============================================================

# -----------------------------------------------------------
# AI SERVICE
# -----------------------------------------------------------
AI_SERVICE_PORT=8089
AI_SERVICE_HOST=0.0.0.0

# -----------------------------------------------------------
# FRONTEND (static server)
# -----------------------------------------------------------
FRONTEND_PORT=8088
FRONTEND_ORIGIN=http://localhost:8088

# -----------------------------------------------------------
# LLM — OpenAI (Phase 3)
# Leave blank to run without LLM features.
# When blank, all LLM endpoints return a "LLM unavailable"
# response and the UI shows a graceful fallback message.
# COST: OpenAI charges per token. Typical session cost < $0.05.
# -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------
# FEATURE FLAGS — set to "true" or "false"
# Each AI feature can be disabled independently.
# -----------------------------------------------------------
ENABLE_ANOMALY_DETECTION=true
ENABLE_ENERGY_FORECAST=true
ENABLE_OCCUPANCY_MODEL=true
ENABLE_THERMOSTAT_RL=true
ENABLE_LLM_CONTROL=true
ENABLE_LLM_INSIGHTS=true
ENABLE_AUTOMATION_GENERATOR=true

# -----------------------------------------------------------
# DATA SIMULATOR
# Controls how often the simulator writes fake sensor readings.
# Set SIMULATOR_INTERVAL_SECONDS=0 to disable the simulator
# (use only when you have real MQTT/sensor data flowing in).
# -----------------------------------------------------------
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_ANOMALY_PROBABILITY=0.03

# -----------------------------------------------------------
# DATABASE
# -----------------------------------------------------------
DB_PATH=ai-service/artifacts/aether.db

# -----------------------------------------------------------
# LOGGING
# -----------------------------------------------------------
LOG_LEVEL=INFO
